<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Permetti connessione a wireshark.org per download OUI -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">wireshark.org</domain>
        <domain includeSubdomains="true">www.wireshark.org</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
